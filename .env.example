# Fixed upstream origin. Only vps.thumbayan.com over HTTPS is accepted.
TARGET_DOMAIN=https://vps.thumbayan.com:443

# Required for relay requests. Use a long random secret and send it as X-Relay-Token.
RELAY_TOKEN=replace-with-a-long-random-secret

# AppDeploy supplies PORT automatically. This is only for local development.
PORT=3000

# Optional upstream timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=55000
